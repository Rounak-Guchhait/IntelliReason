# ── App ──────────────────────────────────────────────────────────────
APP_NAME=IntelliReason
APP_ENV=development
LOG_LEVEL=INFO
MAX_STEPS=8

# ── LLM Provider ─────────────────────────────────────────────────────
# One of: groq | google | openai | openai_compatible
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# Groq (free tier): https://console.groq.com/keys
# LLM_PROVIDER=groq / LLM_MODEL=llama-3.3-70b-versatile | mixtral-8x7b-32768
GROQ_API_KEY=

# Google Gemini (free tier): https://aistudio.google.com/apikey
# LLM_PROVIDER=google / LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
# LLM_PROVIDER=openai / LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint (e.g. Ollama local, OpenRouter, Together):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# OPENAI_API_KEY=sk-whatever

# ── Vector store ─────────────────────────────────────────────────────
# One of: memory | pgvector
VECTOR_STORE=memory
INGESTION_DIR=knowledge_docs

# pgvector (prod) — Supabase free tier: https://supabase.com
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# ── Tools ────────────────────────────────────────────────────────────
# External code-execution sandbox APIs (free tier). Use one or both.
# Piston (public): https://github.com/engineer-man/piston
PISTON_URL=https://emkc.org/api/v2/piston
# Judge0 CE (free tier): https://ce.judge0.com
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
CODE_ENGINE=piston

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000